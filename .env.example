# Community Commerce Melissa — Environment Variables Example
# Add these variables to your Railway project environment settings

# --- Stripe Payment Keys ---
# Find these in your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Used by the server. Next.js client code cannot read this name unless you also
# set NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (same pk_ value). The app now loads
# STRIPE_PUBLISHABLE_KEY via /api/stripe-config when the NEXT_PUBLIC_ var is absent.
STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional: Stripe Webhook Secret (from https://dashboard.stripe.com/webhooks)
# Point webhook endpoint to: https://your-domain.railway.app/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret required to call /api/simulate-member-signup in production
INTERNAL_API_SECRET=

# --- Database Connection ---
# Automatically provided if you attach a Postgres database in Railway
DATABASE_URL=postgresql://postgres:...@...:5432/railway

# --- Email Notifications ---
SENDGRID_API_KEY=SG....
RESEND_API_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://communitycommercemelissa.org
